# Supabase project settings
# NEXT_PUBLIC_SUPABASE_URL is required by browser auth; server code may also use SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app URL used when generating QR links
NEXT_PUBLIC_APP_URL=http://YOUR-LAN-IP:3000

# Demo account to create in Supabase Auth
DEMO_BRANCH_ADMIN_EMAIL=admin@demo-branch.test
DEMO_BRANCH_ADMIN_PASSWORD=DemoBranch123!
